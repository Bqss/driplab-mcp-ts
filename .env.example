# ─── Wajom MCP Server ──────────────────────────────────
WAJOM_DB_PATH=/Users/mac/Projects/driplab/wajomm/driplab-mcp/devdb.sqlite3

# ─── Dripsender MCP Server ─────────────────────────────
DRIPSENDER_DB_PATH=/Users/mac/Projects/driplab/wajomm/driplab-mcp/devdb copy.sqlite3

# ─── Transport (shared by both servers) ────────────────
# stdio (default) = untuk local dev, MCP client spawn sebagai subprocess
# streamable-http = untuk deploy di server, client connect via URL
MCP_TRANSPORT=streamable-http

# Host & port untuk HTTP transport
# Wajom default port: 8100
# Dripsender default port: 8101
MCP_HOST=0.0.0.0
# MCP_PORT=8100  # set per-server
